# Lấy trong Firebase Console → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Mã chuyến đi (mỗi chuyến một mã, đổi nếu muốn tạo chuyến mới)
NEXT_PUBLIC_TRIP_ID=dalat-3n2d

# Đặt 1 để chạy với Firebase Emulator trên máy (npm run emulators)
NEXT_PUBLIC_FIREBASE_EMULATORS=
